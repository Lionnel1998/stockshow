              Stock actuel : <b style={{color:modal==="sortie"?RD:GR}}>{produits.find(p=>p.nom===F.produit)?.stock} unités</b>
            </div>}
            <Inp label="Quantité" value={F.qte} set={v=>sf("qte",v)} ph="50" ic="numbers" req/>

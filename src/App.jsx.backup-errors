              <Legend wrapperStyle={{fontSize:10}}/>
              <Bar dataKey="e" name="Entrées" fill={GR} radius={[4,4,0,0]}/>
              <Bar dataKey="s" name="Sorties" fill={P} radius={[4,4,0,0]}/>
            </BarChart>
          </ResponsiveContainer>

            <Sel label="Produit" value={F.produit} set={v=>sf("produit",v)} opts={produits.map(p=>p.nom)} req/>
            {F.produit&&<div style={{background:P+"0A",borderRadius:10,padding:"9px 13px",marginBottom:12,fontSize:12,color:TXT}}>

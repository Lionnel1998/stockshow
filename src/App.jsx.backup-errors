          fontFamily:f,outline:"none",appearance:"none",cursor:"pointer",
          transition:"border .15s"}}
        onFocus={e=>e.target.style.borderColor=P}
        onBlur={e=>e.target.style.borderColor=BOR}>
        <option value="" disabled>Choisir...</option>
